{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "compile",
      "type": "shell",
      "command": "g++",
      "args": ["-std=c++17", "-o", "${workspaceRoot}/build/${fileBasenameNoExtension}", "${file}"],
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "label": "compile and run",
      "type": "shell",
      "command": "g++ -std=c++17 -o ${workspaceRoot}/build/${fileBasenameNoExtension} ${file} && ${workspaceRoot}/build/${fileBasenameNoExtension} < ${workspaceRoot}/cpp-runner/input.txt > ${workspaceRoot}/cpp-runner/output.txt",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
